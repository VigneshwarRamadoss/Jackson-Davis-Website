---
import Icon from './Icon.astro';
const {posts,cached=false,heading=true}=Astro.props;
---
<section class="section reading" id="reading">{heading&&<div class="section-heading"><div><span class="eyebrow section-kicker">04 / From the film room</span><h2>There’s more to the game<br/>than the box score.</h2></div><a href="/blog/" class="text-link">All writing <Icon name="arrow" size={18}/></a></div>}<div class="post-list">{posts.map((p:any,i:number)=><a class="post-row" href={p.url}><span class="post-index eyebrow">0{i+1}</span><div><span class="eyebrow">{new Date(p.date).toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric',timeZone:'UTC'})} · Basketball analytics</span><h3>{p.title}</h3></div><span class="post-arrow"><Icon name="diagonal" size={24}/></span></a>)}</div>{cached&&<p class="feed-note">From the supplied article archive · <a href="https://jacksondavisttu.substack.com">Visit Substack for the latest ↗</a></p>}<div class="newsletter"><div><span class="eyebrow">A fresh perspective. Every Monday.</span><p>Basketball analytics, video and player development.</p></div><a class="button button-dark" href="https://jacksondavisttu.substack.com/subscribe">Subscribe on Substack <Icon name="diagonal" size={17}/></a></div></section>
