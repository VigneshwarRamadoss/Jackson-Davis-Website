---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
const {title='Know which plays actually score.',description='Game-day trackers, scouting templates and custom apps, built by a D1 video coordinator.',hero=false} = Astro.props;
const nav=[['Home','/'],['Tools','/tools/'],['Custom Apps','/custom-apps/'],['Blog','/blog/'],['About','/about/'],['Contact','/contact/']];
const origin='https://jackson-davis-courtside.vigneshwarr2035.chatgpt.site';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#173f40"/><title>{title} — Jackson Davis</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={origin+Astro.url.pathname}/><meta property="og:title" content={`${title} — Jackson Davis`}/><meta property="og:description" content={description}/><meta property="og:image" content={`${origin}/images/courtside.webp`}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><slot name="head"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Jackson Davis',jobTitle:'Video Coordinator',sameAs:['https://x.com/JacksonDavisTTU','https://jacksondavisttu.substack.com','https://stan.store/JacksonDavis']})}/></head><body class:list={[hero&&'home']}><a class="skip" href="#main">Skip to content</a>
<header class:list={['header',hero&&'header-hero']}><a href="/" class="wordmark" aria-label="Jackson Davis home"><Icon name="ball" size={27}/><span>Jackson Davis<span class="wordmark-dot">.</span></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}</nav><a class="button nav-cta" href="/tools/">Browse tools <Icon name="diagonal" size={15}/></a><button class="menu-toggle" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></button></header>
<dialog id="mobile-menu"><div class="mobile-menu-top"><a href="/" class="wordmark">Jackson Davis.</a><button class="menu-close" aria-label="Close navigation">✕</button></div><nav aria-label="Mobile navigation">{nav.map(([label,url],i)=><a href={url}><small>0{i+1}</small>{label}<Icon name="diagonal"/></a>)}</nav></dialog>
<main id="main"><slot/></main>
<footer id="footer"><div class="footer-top"><div><a class="wordmark" href="/"><Icon name="ball" size={29}/> Jackson Davis.</a><p>Built for the people<br/>who see the game differently.</p></div><div><span class="eyebrow">Explore</span><a href="/tools/">The tools</a><a href="/custom-apps/">Custom apps</a><a href="/about/">About Jackson</a></div><div><span class="eyebrow">Keep learning</span><a href="/blog/">The film room</a><a href="https://jacksondavisttu.substack.com/subscribe">Newsletter ↗</a><a href="https://x.com/JacksonDavisTTU">Find me on X ↗</a></div><div class="footer-note"><span class="eyebrow">Let's talk basketball</span><p>Have a question, an idea,<br/>or a workflow to improve?</p><a class="text-link" href="/contact/">Get in touch <Icon name="diagonal" size={16}/></a></div></div><div class="footer-bottom"><span>© 2026 Jackson Davis</span><span>Basketball. Data. Better decisions.</span><div><a href="/privacy/">Privacy</a><button class="reset-preferences">Reset preferences</button></div></div><div class="preferences" id="preferences"><span>Remember my preferences on this device?</span><button data-consent="granted">Yes</button><button data-consent="denied">No</button><span id="preference-status" role="status"></span></div></footer>
<script>
import '../lib/client';
</script></body></html>
