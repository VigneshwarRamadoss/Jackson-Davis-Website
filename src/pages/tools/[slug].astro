---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import Icon from '../../components/Icon.astro';
import tools from '../../data/tools.json';
import bundles from '../../data/bundles.json';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const cat:Record<string,string>={'game-day':'Game day','scouting-lineups':'Scouting & lineups',recruiting:'Recruiting'};
const related=tools.filter(t=>t.category===tool.category&&t.slug!==tool.slug);
const included=bundles.filter(b=>b.includes.includes(tool.slug));
---
<Base title={tool.name} description={tool.summary}><Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Product',name:tool.name,description:tool.summary,offers:{'@type':'Offer',price:tool.priceUsd,priceCurrency:'USD',url:tool.stanUrl}})}/></Fragment><section class="section"><a class="eyebrow text-link" href={`/tools/?cat=${tool.category}`}>Tools / {cat[tool.category]} ←</a><div class="detail-layout" style="margin-top:35px"><div class="detail-copy"><span class="eyebrow section-kicker">{cat[tool.category]} {tool.format==='excel'?' / Excel':tool.format==='web-app'?' / Web app':''}</span><h1>{tool.name}</h1><p>{tool.summary}</p><div class="detail-price">${tool.priceUsd}<small>USD · one-time purchase</small></div><a class="button" data-stan={tool.slug} href={`${tool.stanUrl}?utm_source=site&utm_medium=tool_page&utm_campaign=${tool.slug}`}>Buy on Stan – ${tool.priceUsd} <Icon name="diagonal" size={18}/></a><p class="fineprint">Secure checkout and delivery through Stan. {tool.format==='unknown'?'Format and system requirements: check the Stan listing.':''}</p></div><div class="detail-art"><Icon name={tool.category==='recruiting'?'layers':'court'} size={120}/><span class="eyebrow">Real product screenshots are awaiting supply.<br/>This is a category illustration, not the app interface.</span></div></div></section>{'features' in tool&&<section class="section editorial" style="padding-top:0"><span class="eyebrow section-kicker">Built for the live game</span><h2>What it does.</h2><ul class="feature-list">{(tool.features as string[]).map(f=><li><Icon name="check" size={19}/>{f}</li>)}</ul></section>}{included.length>0&&<section class="section editorial" style="padding-top:0"><span class="eyebrow section-kicker">Better together</span><h2>Also in a bundle.</h2>{included.map(b=><a class="text-link" href="/tools/#bundles">{b.name} · ${b.priceUsd} <Icon name="arrow"/></a>)}</section>}<section class="section tool-section"><div class="section-heading"><div><span class="eyebrow section-kicker">Keep building your toolkit</span><h2>More for {cat[tool.category].toLowerCase()}.</h2></div></div><div class="tool-grid">{related.map((t,i)=><ToolCard tool={t} index={i}/>)}</div></section></Base>
